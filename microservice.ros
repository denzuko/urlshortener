#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  (asdf:load-asd (merge-pathnames "microservice.asd" *load-pathname*))
  #+quicklisp(ql:quickload '(:microservice
                             :hunchentoot
                             :easy-routes
                             :com.inuoe.jzon
                             :bknr.datastore
                             :ironclad babel
                             :bordeaux-threads
                             :cl-base64) :silent t))

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defpackage :ros.script.microservice.3995270669
  (:use :cl :microservice)
  (:export #:main
           #:parse-args
           #:daemonize))

(in-package :ros.script.microservice.3995270669)

(defvar *start-time* (get-universal-time))
(defvar *schema-version* "v1"
  "Bump anytime the object class gets updated so the objectstore doesn't break")

(defparameter *port* 11000)
(defparameter *object-storage* (make-pathname :directory 
                                              (list :absolute 
                                                 "dev"
                                                 "shm"
                                                 "objstore"
                                                 *schema-version*)))
(defparameter *log-path* "/tmp/microservice.log")

(defstruct cli-opts 
  (help     nil              :type boolean)
  (daemon   nil              :type boolean)
  (port     *port*           :type integer)
  (storage  *object-storage* :type (or null pathname string))
  (log-path *log-path*       :type (or null pathname string)))

(defmacro pop-config-value (slot-name parse-form &body validations) 
  "Pops a raw string from ARGV, evaluates PARSE-FORM (with ARG-VALUE
   bound to that raw string) to produce a parsed value (bound to
   PARSED-VALUE). Each entry in VALIDATIONS is (FAIL-TEST
   ERROR-FORMAT) -- tried in order; the first FAIL-TEST that's true
   warns using ERROR-FORMAT (given the raw string) and exits with
   status 1. If no FAIL-TEST matches, KEY is set to PARSED-VALUE."
  (let ((raw (gensym "RAW"))
        (setter (intern (string-upcase (format nil "cli-opts-~A" (symbol-name slot-name))))))
    `(let* ((,raw (pop argv))
            (parsed-value (let ((arg-value ,raw)) ,parse-form)))
       (cond ,@(loop for (fail-test error-format) in validations
                     collect `(,fail-test (warn ,error-format ,raw) (uiop:quit 1)))
             (t (setf (,setter opts) parsed-value))))))

(defmacro set-config-boolean (slot-name)
  "Toggles KEY to T in enclosing OPTS plist"
  (let ((setter (intern (string-upcase (format nil "cli-opts-~A" (symbol-name slot-name))))))
    `(setf (,setter opts) t)))

(defun parse-args (argv)
  "Parses ARGV into options plist"
  (let ((opts (make-cli-opts)))
    (loop while argv
          for arg = (pop argv)
          do (cond ((string= arg "-d") (set-config-boolean :daemon))
                   ((string= arg "-h") (set-config-boolean :help))
                   ((string= arg "-s") (pop-config-value :storage
                                         (uiop:ensure-directory-pathname arg-value)))
                   ((string= arg "-l") (pop-config-value :log-path arg-value))
                   ((string= arg "-p") (pop-config-value :port
                                        (and arg-value (parse-integer arg-value :junk-allowed t))
                                        ((not (typep parsed-value '(integer 1025 65535)))
                                         "Port number ~s was not in range of 1025-65535")))
                   (t (warn "Unknown argument: ~a" arg))))
    opts))

(defun daemonize (log-path)
  "fork and detach"
#+sbcl
(progn
  (require :sb-posix)
  (let ((pid (sb-posix:fork)))
    (cond ((plusp pid) (sb-ext:exit :code 0 :abort t))
          (t (sb-posix:setsid)
             (let ((out (open log-path
                              :direction :output
                              :if-exists :append
                              :if-does-not-exist :create)))
               (setf *standard-output* out
                     *error-output* out))))))
#-sbcl
(warn "Daemonize only implemented for SBCL."))

(defun main (&rest argv)
  (declare (ignorable argv))
  (let* ((opts (parse-args argv))
        (object-storage (uiop:ensure-directory-pathname (cli-opts-storage opts)))
        (acceptor (make-instance 'easy-routes:routes-acceptor :port (cli-opts-port opts))))

    (when (cli-opts-help opts)
      (format t "Usage: microservice.ros [-d] [-p PORT_NUM] [-s STORAGE_PATH] [-l LOG_PATH]~%")
      (uiop:quit 0))

    (when (cli-opts-daemon opts)
      (daemonize (cli-opts-log-path opts)))

    (ensure-directories-exist object-storage :verbose nil)
    (make-instance 'bknr.datastore:mp-store
                   :directory (namestring object-storage)
                   :subsystems (list
                                 (make-instance 'bknr.datastore:store-object-subsystem)))

    (route! (:name handle-swagger :path "/swagger.json")
          (list :|openapi| "3.0.3"
                :|info| (list :|title| "URL Shortener" :|version| "1.0.0")
                :|paths| (list :|/|
                               (list :|post| (list :|summary| "Create a short URL"
                                                   :|responses| (list :|200| 
                                                                (list :|description| "Short URL created"))))
                               :|/{shrt}|
                               (list :|get|  (list :|summary| "Resolve and redirect"
                                     :|responses| (list 
                                     :|302| (list :|description| "Redirect to the long URL")
                                     :|404| (list :|description| "Short URL not found")))
                    :|put|    (list :|summary| "Update (unimplemented)"
                                     :|responses| (list :|501| (list :|description| "Not implemented")))
                    :|delete| (list :|summary| "Delete (unimplemented)"
                                     :|responses| (list :|501| (list :|description| "Not implemented"))))
              :|/metrics|
              (list :|get| (list :|summary| "Prometheus metrics"
                                  :|responses| (list :|200| (list :|description| "Metrics in Prometheus text format"))))
              :|/healthz|
              (list :|get| (list :|summary| "Health check"
                                  :|responses| (list :|200| (list :|description| "Service is healthy")))))))

    (route! (:name handle-metrics :path "/metrics" :content-type :text) 
        (format nil "~
# HELP urlshortener_uptime_seconds Seconds since the process started. 
# TYPE urlshortener_uptime_seconds gauge
urlshortener_uptime_seconds ~D
# HELP urlshortener_urls_total Total short URLS stored. 
# TYPE urlshortener_urls_total gauge
urlshortener_urls_total ~D
" 
               (- (get-universal-time) *start-time*)
            (length (all-shorten-urls))))

    (route! (:name handle-healthz :path "/healthz") (ok))
  
    (route! (:name handle-root-update :path "/:shrt" :method :PUT)
          (unimplimented (format nil "root update (~a)" shrt)))

    (route! (:name handle-root-delete :path "/:shrt" :method :DELETE)
          (unimplimented (format nil "root delete (~a)" shrt)))

    (route! (:name handle-root-read :path "/:shrt")
        (let ((url-obj (shorten-url-by-short-url shrt)))
          (cond (url-obj (redirect! (shorten-url-long-url url-obj)))
                (t       (notfound shrt)))))

    (route! (:name handle-root-create :path "/" :method :POST)
        (let* ((long-url (gethash "long-url" body))
               (shrt (make-shorten-url long-url)))
          (list :|short-url| shrt)))

    (let ((shutdown-semaphore (bt:make-semaphore :name "server-shutdown")))
        #+sbcl
        (sb-sys:enable-interrupt sb-unix:sigterm
                              (lambda (&rest args)
                                (declare (ignore args))
                                (bt:signal-semaphore shutdown-semaphore)))

        (hunchentoot:start acceptor)
        (format t "Server started on port ~A...~%" (cli-opts-port opts))

        (handler-case (bt:wait-on-semaphore shutdown-semaphore)
            (sb-sys:interactive-interrupt () (format t "~&Interrupt caught.~%")))

        (format t "~&Shutting down...~%")
        (hunchentoot:stop acceptor :soft t))
))
;;; vim: set ft=lisp lisp:
