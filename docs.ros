#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn
  (ros:ensure-asdf)
  (asdf:load-asd (merge-pathnames "microservice.asd" *load-pathname*))
  #+quicklisp(ql:quickload '(:microservice/docs
                             :40ants-doc :40ants-doc-full) :silent t))

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defpackage :ros.script.docs.3995270669
  (:use :cl :40ants-doc :microservice/docs))
(in-package :ros.script.docs.3995270669)

(defun main (&rest argv)
  (declare (ignore argv))
  (let ((markdown (40ants-doc-full/builder:render-to-string
                    (symbol-value (find-symbol "@MICROSERVICE-MANUAL" "MICROSERVICE/DOCS"))
                    :format :markdown)))
    (ensure-directories-exist "build/")
    (with-open-file (out "build/microservice.md"
                          :direction :output :if-exists :supersede)
      (write-string markdown out))
    (format t "Wrote build/microservice.md~%")))

;;; vim: set ft=lisp lisp:
